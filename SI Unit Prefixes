                                <option value="m" data-i18n="unit_m">Meter (m)</option>
                                <option value="g" data-i18n="unit_g">Gram (g)</option>
                                <option value="s" data-i18n="unit_s">Second (s)</option>
                                <option value="A" data-i18n="unit_A">Ampere (A)</option>
                                <option value="W" data-i18n="unit_W">Watt (W)</option>
                                <option value="Hz" data-i18n="unit_Hz">Hertz (Hz)</option>
                                <option value="B" data-i18n="unit_B">Byte (B)</option>
                            </select>
