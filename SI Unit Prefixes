                        <input type="number" id="input-value" value="1" step="any" class="w-full p-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-lg text-center" placeholder="e.g. 5">
                    </div>
                    
                    <!-- Prefix Dropdown -->
                    <div class="w-full md:w-2/4">
                        <label class="block text-sm font-medium text-slate-700 mb-1" data-i18n="lblPrefix">Select Prefix</label>
                        <select id="select-prefix" class="w-full p-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-lg font-medium">
