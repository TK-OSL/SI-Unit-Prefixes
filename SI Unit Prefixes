                toolsHeader: "เครื่องมือโต้ตอบ",
                t1Title: "เครื่องมือ 1: ถอดรหัสคำอุปสรรค",
                t1Desc: "กรอกตัวเลข เลือกคำอุปสรรค และเลือกหน่วยพื้นฐาน เพื่อดูค่าทางคณิตศาสตร์ที่แท้จริง",
                lblNum: "กรอกตัวเลข",
                lblPrefix: "เลือกคำอุปสรรค",
                lblUnit: "เลือกหน่วยพื้นฐาน",
                optNoPrefix: "-- ไม่มีคำอุปสรรค (หน่วยหลัก) --",
                resultTitle: "ผลการแปลง",
                sciNotation: "สัญกรณ์วิทยาศาสตร์:",
                t2Title: "เครื่องมือ 2: หาคำอุปสรรคที่เหมาะสมที่สุด",
                badgeNew: "ใหม่",
                t2Desc: "พิมพ์ตัวเลขที่มีค่ามากหรือน้อยมากๆ ระบบจะแปลงเป็นคำอุปสรรคที่เหมาะสมที่สุดให้อัตโนมัติ (ทวีคูณของ 10³)",
                lblRawNum: "กรอกตัวเลขดิบ",
                lblRawUnit: "เลือกหน่วยพื้นฐาน",
                sugFormat: "รูปแบบที่แนะนำ",
                usingPrefix: "ใช้คำอุปสรรค:",
                baseUnitNone: "หน่วยพื้นฐาน (ไม่มีคำอุปสรรค)",
                submultiplesHeader: "ค่าน้อยกว่า 1 (Submultiples)",
                seeSciFormat: "ดูสัญกรณ์วิทยาศาสตร์",
                footer1: "สร้างขึ้นเพื่อวัตถุประสงค์ทางการศึกษา",
                footer2: "ขับเคลื่อนโดย <a href=\"https://opensimlab.org\" target=\"_blank\" class=\"text-indigo-600 hover:underline hover:text-indigo-800 transition\">OpenSimLab.org</a> & Gemini AI",
                // units
                unit_m: "เมตร (m)",
                unit_g: "กรัม (g)",
                unit_s: "วินาที (s)",
                unit_A: "แอมแปร์ (A)",
                unit_W: "วัตต์ (W)",
                unit_Hz: "เฮิรตซ์ (Hz)",
                unit_B: "ไบต์ (B)"
            }
        };

        let currentLang = 'en';

        /**
         * SI Prefixes Data
         * Contains the standard SI prefixes used for learning and quiz generation.
         */
        const siPrefixes = [
            { name: "yotta", thaiName: "ยอตตะ", symbol: "Y", power: 24, multiplier: "1,000,000,000,000,000,000,000,000" },
            { name: "zetta", thaiName: "เซตตะ", symbol: "Z", power: 21, multiplier: "1,000,000,000,000,000,000,000" },
            { name: "exa", thaiName: "เอกซะ", symbol: "E", power: 18, multiplier: "1,000,000,000,000,000,000" },
            { name: "peta", thaiName: "เพตะ", symbol: "P", power: 15, multiplier: "1,000,000,000,000,000" },
            { name: "tera", thaiName: "เทระ", symbol: "T", power: 12, multiplier: "1,000,000,000,000" },
            { name: "giga", thaiName: "จิกะ", symbol: "G", power: 9, multiplier: "1,000,000,000" },
            { name: "mega", thaiName: "เมกะ", symbol: "M", power: 6, multiplier: "1,000,000" },
            { name: "kilo", thaiName: "กิโล", symbol: "k", power: 3, multiplier: "1,000" },
            { name: "hecto", thaiName: "เฮกโต", symbol: "h", power: 2, multiplier: "100" },
            { name: "deka", thaiName: "เดคา", symbol: "da", power: 1, multiplier: "10" },
            // Base unit implicitly here (10^0)
            { name: "deci", thaiName: "เดซิ", symbol: "d", power: -1, multiplier: "0.1" },
            { name: "centi", thaiName: "เซนติ", symbol: "c", power: -2, multiplier: "0.01" },
            { name: "milli", thaiName: "มิลลิ", symbol: "m", power: -3, multiplier: "0.001" },
            { name: "micro", thaiName: "ไมโคร", symbol: "μ", power: -6, multiplier: "0.000 001" },
            { name: "nano", thaiName: "นาโน", symbol: "n", power: -9, multiplier: "0.000 000 001" },
            { name: "pico", thaiName: "พิโก", symbol: "p", power: -12, multiplier: "0.000 000 000 001" },
            { name: "femto", thaiName: "เฟมโต", symbol: "f", power: -15, multiplier: "0.000 000 000 000 001" },
            { name: "atto", thaiName: "อัตโต", symbol: "a", power: -18, multiplier: "0.000 000 000 000 000 001" },
            { name: "zepto", thaiName: "เซปโต", symbol: "z", power: -21, multiplier: "0.000 000 000 000 000 000 001" },
            { name: "yocto", thaiName: "ยอกโต", symbol: "y", power: -24, multiplier: "0.000 000 000 000 000 000 000 001" }
        ];

        // DOM Elements
        const btnLearn = document.getElementById('btn-learn');
        const btnExamples = document.getElementById('btn-examples');
        const sectionLearn = document.getElementById('section-learn');
        const sectionExamples = document.getElementById('section-examples');
        const tableBody = document.getElementById('prefix-table-body');
        
        // Example Elements
        const inputValue = document.getElementById('input-value');
        const selectPrefix = document.getElementById('select-prefix');
        const selectUnit = document.getElementById('select-unit');
        const displayInputTerm = document.getElementById('display-input-term');
        const displayResultDecimal = document.getElementById('display-result-decimal');
        const displayResultScientific = document.getElementById('display-result-scientific');
        const displayResultUnit = document.getElementById('display-result-unit');

        // New Tool 2 Elements
        const inputRawValue = document.getElementById('input-raw-value');
        const selectRawUnit = document.getElementById('select-raw-unit');
        const displayBestResult = document.getElementById('display-best-result');
        const displayBestName = document.getElementById('display-best-name');
        const displayBestScientific = document.getElementById('display-best-scientific');
        const displayBestScientificUnit = document.getElementById('display-best-scientific-unit');

        function init() {
            setLanguage(currentLang); // Initialize language and populate everything
            setupEventListeners();
        }

        /**
         * Change Language Function
         */
        function setLanguage(lang) {
            currentLang = lang;

            // Update toggle buttons styling
            const btnEn = document.getElementById('btn-lang-en');
            const btnTh = document.getElementById('btn-lang-th');
            
            if (lang === 'en') {
                btnEn.className = "lang-btn active";
                btnTh.className = "lang-btn inactive";
            } else {
                btnEn.className = "lang-btn inactive";
                btnTh.className = "lang-btn active";
            }

            // Translate static DOM text elements
            document.querySelectorAll('[data-i18n]').forEach(element => {
                const key = element.getAttribute('data-i18n');
                if (translations[lang][key]) {
                    element.innerHTML = translations[lang][key];
                }
            });

            // Save current selections before re-populating dropdowns
            const selectedPrefixIndex = selectPrefix.value || "7"; // default to kilo
            const selectedUnitVal = selectUnit.value || "m";
            const selectedRawUnitVal = selectRawUnit.value || "m";

            // Re-populate Table and Dropdown to reflect new language names
            populateTable();
            populatePrefixDropdown();

            // Restore selections
            selectPrefix.value = selectedPrefixIndex;
            selectUnit.value = selectedUnitVal;
            selectRawUnit.value = selectedRawUnitVal;

            // Re-trigger calculations to update dynamic text
            calculateAndDisplay();
            calculateBestPrefix();
        }

        /**
         * Populates the learning table with data from siPrefixes array.
         */
        function populateTable() {
            tableBody.innerHTML = '';
            
            // Add a visual separator for negative powers
            let separatorAdded = false;

            siPrefixes.forEach(prefix => {
                
                // Add a slightly different background for submultiples (negative powers)
                if (prefix.power < 0 && !separatorAdded) {
                    const sepRow = document.createElement('tr');
                    sepRow.innerHTML = `<td colspan="4" class="bg-indigo-50 text-center text-xs py-1 text-indigo-400 font-semibold uppercase tracking-wider">${translations[currentLang].submultiplesHeader}</td>`;
                    tableBody.appendChild(sepRow);
                    separatorAdded = true;
                }

                const tr = document.createElement('tr');
                tr.className = `hover:bg-slate-50 transition duration-150 border-b border-slate-100 ${prefix.power > 0 ? '' : 'bg-slate-50/30'}`;
                
                const displayName = currentLang === 'th' ? prefix.thaiName : prefix.name;

                tr.innerHTML = `
                    <td class="p-3 whitespace-nowrap">
                        <span class="font-bold text-slate-800 capitalize">${displayName}</span>
                    </td>
                    <td class="p-3 text-lg font-semibold font-mono text-indigo-600">${prefix.symbol}</td>
                    <td class="p-3 text-right font-mono text-sm text-slate-600 whitespace-nowrap">${prefix.multiplier}</td>
                    <td class="p-3 font-mono font-bold text-slate-800">10<sup>${prefix.power}</sup></td>
                `;
                tableBody.appendChild(tr);
            });
        }

        /**
         * Populates the prefix dropdown for the Example section
         */
        function populatePrefixDropdown() {
            selectPrefix.innerHTML = ''; // clear existing
            
            // Add "No Prefix" base option
            const baseOpt = document.createElement('option');
            baseOpt.value = "none";
            baseOpt.textContent = translations[currentLang].optNoPrefix;
            selectPrefix.appendChild(baseOpt);

            siPrefixes.forEach((prefix, index) => {
                const opt = document.createElement('option');
                opt.value = index;
                const displayName = currentLang === 'th' ? prefix.thaiName : prefix.name;
                opt.textContent = `${displayName} (${prefix.symbol}) : 10^${prefix.power}`;
                selectPrefix.appendChild(opt);
            });
        }

        /**
         * Core logic to calculate and render the example values
         */
        function calculateAndDisplay() {
            const val = parseFloat(inputValue.value);
            const unit = selectUnit.value;
            const prefixVal = selectPrefix.value;
            
            // Handle empty or invalid input
            if (isNaN(val)) {
                displayInputTerm.innerHTML = `-`;
                displayResultDecimal.innerHTML = `-`;
                displayResultScientific.innerHTML = `-`;
                displayResultUnit.innerHTML = unit;
                return;
            }

            let prefixSymbol = "";
            let power = 0;

            if (prefixVal !== "none") {
                const prefixData = siPrefixes[parseInt(prefixVal)];
                prefixSymbol = prefixData.symbol;
                power = prefixData.power;
            }

            // 1. Display Left Term (e.g. "5 km")
            displayInputTerm.innerHTML = `${val} ${prefixSymbol}${unit}`;

            // Calculate actual numerical value accurately avoiding typical JS floating point errors
            const baseValueStr = val + 'e' + power;
            let baseValue = Number(baseValueStr);

            // 2. Format Scientific Term
            if (baseValue === 0) {
                displayResultScientific.innerHTML = `0`;
            } else {
                const expString = baseValue.toExponential(); 
                const parts = expString.split('e');
                const mantissa = parseFloat(parts[0]);
                const exponent = parseInt(parts[1]);
                
                if (exponent === 0) {
                    displayResultScientific.innerHTML = `${mantissa}`;
                } else {
                    displayResultScientific.innerHTML = `${mantissa} &times; 10<sup>${exponent}</sup>`;
                }
            }
            displayResultUnit.innerHTML = unit;

            // 3. Format Decimal Term
            if (baseValue === 0) {
                 displayResultDecimal.innerHTML = `0 ${unit}`;
            } else if (Math.abs(power) > 15 || Math.abs(baseValue) >= 1e16) {
                displayResultDecimal.innerHTML = `<span class="text-xl text-indigo-200 font-normal italic">${translations[currentLang].seeSciFormat}</span>`;
            } else {
                let formattedDec = baseValue.toLocaleString('en-US', { 
                    maximumFractionDigits: 20,
                    useGrouping: true
                });
                displayResultDecimal.innerHTML = `${formattedDec} ${unit}`;
            }
        }

        /**
         * Tool 2: Logic to find the best prefix for a raw number
         */
        function calculateBestPrefix() {
            const val = parseFloat(inputRawValue.value);
            const unit = selectRawUnit.value;
            
            if (isNaN(val) || val === 0) {
                displayBestResult.innerHTML = `0 <span class="text-indigo-300">${unit}</span>`;
                displayBestName.textContent = translations[currentLang].baseUnitNone;
                displayBestScientific.innerHTML = `0`;
                displayBestScientificUnit.innerHTML = unit;
                return;
            }

            const absVal = Math.abs(val);
            
            // Find engineering power
            let engPower = Math.floor(Math.log10(absVal) / 3) * 3;

            // Cap to our available prefixes
            if (engPower > 24) engPower = 24;
            if (engPower < -24) engPower = -24;

            // Find the matching prefix
            let bestPrefix = siPrefixes.find(p => p.power === engPower);
            
            let prefixSymbol = "";
            let prefixName = translations[currentLang].baseUnitNone;
            let divisor = 1;

            if (bestPrefix && engPower !== 0) {
                prefixSymbol = bestPrefix.symbol;
                const displayName = currentLang === 'th' ? bestPrefix.thaiName : bestPrefix.name;
                prefixName = `${displayName} (${prefixSymbol})`;
                divisor = Number('1e' + engPower);
            }

            const finalValue = val / divisor;
            
            let formattedVal = finalValue.toLocaleString('en-US', {
                maximumFractionDigits: 3,
                useGrouping: true
            });

            displayBestResult.innerHTML = `${formattedVal} <span class="text-indigo-300">${prefixSymbol}${unit}</span>`;
            displayBestName.textContent = prefixName;

            const expString = val.toExponential(); 
            const parts = expString.split('e');
            const mantissa = parseFloat(parts[0]);
            const exponent = parseInt(parts[1]);
            
            if (exponent === 0) {
                displayBestScientific.innerHTML = `${mantissa}`;
            } else {
                displayBestScientific.innerHTML = `${mantissa} &times; 10<sup>${exponent}</sup>`;
            }
            displayBestScientificUnit.innerHTML = unit;
        }

        /**
         * Sets up UI event listeners for buttons and tabs.
         */
        function setupEventListeners() {
            // Tab switching
            btnLearn.addEventListener('click', () => {
                sectionLearn.classList.remove('hide');
                sectionExamples.classList.add('hide');
                
                btnLearn.className = "px-6 py-2 bg-indigo-600 text-white rounded-full font-semibold shadow-md hover:bg-indigo-700 transition duration-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-opacity-50";
                btnExamples.className = "px-6 py-2 bg-white text-indigo-600 border border-indigo-600 rounded-full font-semibold shadow-sm hover:bg-indigo-50 transition duration-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-opacity-50";
            });

            btnExamples.addEventListener('click', () => {
                sectionLearn.classList.add('hide');
                sectionExamples.classList.remove('hide');
                
                btnExamples.className = "px-6 py-2 bg-indigo-600 text-white rounded-full font-semibold shadow-md hover:bg-indigo-700 transition duration-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-opacity-50";
                btnLearn.className = "px-6 py-2 bg-white text-indigo-600 border border-indigo-600 rounded-full font-semibold shadow-sm hover:bg-indigo-50 transition duration-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-opacity-50";
            });

            // Interactive Example Listeners
            inputValue.addEventListener('input', calculateAndDisplay);
            selectPrefix.addEventListener('change', calculateAndDisplay);
            selectUnit.addEventListener('change', calculateAndDisplay);

            // Tool 2 Listeners
            inputRawValue.addEventListener('input', calculateBestPrefix);
            selectRawUnit.addEventListener('change', calculateBestPrefix);
        }

        // Run init on load
        window.addEventListener('DOMContentLoaded', init);

    </script>
</body>
